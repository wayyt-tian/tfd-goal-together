# 本地运行 npm run db:setup 自动生成 .env；远程环境按需填写。
POSTGRES_PASSWORD=请设置独立密码
POSTGRES_PORT=55436
DATABASE_URL=postgres://goal_together:密码@127.0.0.1:55436/goal_together
DEMO_DATABASE_URL=postgres://goal_together:密码@127.0.0.1:55436/goal_together_demo
TEST_DATABASE_URL=postgres://goal_together:密码@127.0.0.1:55436/goal_together_test
# DATABASE_SCHEMA=public
# BACKUP_DIR=/绝对路径/备份
# PG_POOL_MAX=10

# HOST=127.0.0.1
# PORT=4173
# PUBLIC_ORIGIN=https://目标工作台.example.com

# npm start 默认同地址双模式；npm run demo 仍仅演示。
# GUOQI_DATA_DIR=/绝对路径/本地文件
# APP_BIND=0.0.0.0
# APP_PORT=4182
# RESTORE_DATABASE_URL=postgres://独立账号:密码@数据库地址/新建空库
# FORMAL_DATABASE_NAME=goal_together
